# .env.example
#
# Environment variable overrides for API keys loaded by AppConfig via pydantic-settings.
# Copy this file to .env and fill in real values. The .env file is gitignored.
# Keys defined here override the api_key fields in config.yaml's endpoints section.
# Variable names follow the pattern: FICTIONWRITER_ENDPOINTS__<ROLE>__API_KEY
# (double underscore = nested YAML path separator for pydantic-settings).

FICTIONWRITER_ENDPOINTS__PLANNER__API_KEY=your-planner-api-key-here
FICTIONWRITER_ENDPOINTS__DRAFTER__API_KEY=your-drafter-api-key-here
FICTIONWRITER_ENDPOINTS__CRITIC__API_KEY=your-critic-api-key-here
FICTIONWRITER_ENDPOINTS__PAD_TRANSLATOR__API_KEY=your-pad-translator-api-key-here
FICTIONWRITER_ENDPOINTS__CRAFT_CONSULTANT__API_KEY=your-craft-consultant-api-key-here
